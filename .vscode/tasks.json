{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "process",
            "command": "bash",
            "args": [
                "--norc",
                "-c",
                "export CY_TOOLS_PATHS=${config:modustoolbox.toolsPath} ; make build TOOLCHAIN=GCC_ARM CONFIG=Debug "
            ],
            "windows": {
                "command": "${config:modustoolbox.toolsPath}/modus-shell/bin/bash.exe",
                "args": [
                    "--norc",
                    "-c",
                    "export PATH=/bin:/usr/bin:$PATH ; export CY_TOOLS_PATHS=${config:modustoolbox.toolsPath} ; ${config:modustoolbox.toolsPath}/modus-shell/bin/make.exe build TOOLCHAIN=GCC_ARM CONFIG=Debug"
                ]
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Rebuild",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Clean",
                "Build"
            ],
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "Clean",
            "type": "process",
            "command": "bash",
            "args": [
                "--norc",
                "-c",
                "export CY_TOOLS_PATHS=${config:modustoolbox.toolsPath} ; make clean  "
            ],
            "windows": {
                "command": "${config:modustoolbox.toolsPath}/modus-shell/bin/bash.exe",
                "args": [
                    "--norc",
                    "-c",
                    "export PATH=/bin:/usr/bin:$PATH ; export CY_TOOLS_PATHS=${config:modustoolbox.toolsPath} ; ${config:modustoolbox.toolsPath}/modus-shell/bin/make.exe clean "
                ]
            }
        },
        {
            // Flash only. "Build" is the default task, so Ctrl+Shift+B
            // never flashes a stale hex.
            "label": "Program",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/flash.ps1"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build"
            }
        },
        {
            // Skips probe detection (~1 s faster).
            "label": "Program (DAPLink, fast)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/flash.ps1",
                "-Probe",
                "daplink"
            ],
            "problemMatcher": []
        },
        {
            // Erase button -> this task (extension mapActionToTask:
            // case "erase"). Erases main flash via flash.ps1.
            "label": "Erase Device",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/flash.ps1",
                "-Erase",
                "Main"
            ],
            "problemMatcher": []
        },
        {
            "hide": false,
            "label": "Advanced Programming",
            "type": "process",
            "command": "bash",
            "args": [
                "--norc",
                "-c",
                "make advanced_program"
            ],
            "windows": {
                "command": "${config:modustoolbox.toolsPath}/modus-shell/bin/bash.exe",
                "args": [
                    "--norc",
                    "-c",
                    "export PATH=/bin:/usr/bin:$PATH ; ${config:modustoolbox.toolsPath}/modus-shell/bin/make.exe advanced_program"
                ]
            },
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "Tool: Library Manager",
            "type": "process",
            "command": "bash",
            "args": [
                "--norc",
                "-c",
                "make modlibs MTB__JOB_BACKGROUND="
            ],
            "windows": {
                "command": "${config:modustoolbox.toolsPath}/modus-shell/bin/bash.exe",
                "args": [
                    "--norc",
                    "-c",
                    "export PATH=/bin:/usr/bin:$PATH ; ${config:modustoolbox.toolsPath}/modus-shell/bin/make.exe modlibs MTB__JOB_BACKGROUND="
                ]
            }
        },
        {
            // Erase button, "Erase All" mode -> this task (case "erase-all").
            // Erases main + work flash.
            "label": "Erase All",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/flash.ps1",
                "-Erase",
                "All"
            ],
            "problemMatcher": []
        },
        {
            // Program button -> this task (case "program"). The name cannot be
            // changed: the extension matches it. It only flashes, because
            // "Program" here skips the build. Do not run "Fix Tasks and
            // Settings", it resets this to 'make program' (KitProg3 only).
            "label": "Build & Program",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Program"
            ],
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "Build & Program (DAPLink, fast)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build",
                "Program (DAPLink, fast)"
            ],
            "group": {
                "kind": "build"
            }
        },
        {
            // Program button, "Quick Program" mode -> this task (case
            // "quick-program"). Same flash, no read-back.
            "label": "Quick Program",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/flash.ps1",
                "-SkipVerify"
            ],
            "problemMatcher": []
        }
    ]
}